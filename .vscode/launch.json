{
    "configurations": [
        {
            "name": "Python: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            // "python": "/usr/bin/python3",
            "justMyCode": true,
            "stopOnEntry": false,
            "env": {"PYTHONUNBUFFERED": "1"}
        },
        {
            "name": "Python: Unittest",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["discover", "-s", "tests", "-p", "test_*.py"],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}